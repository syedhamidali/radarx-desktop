{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xradar-desktop",
  "version": "0.2.0",
  "identifier": "com.xradar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "xradar desktop",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*; img-src 'self' asset: https://api.mapbox.com https://*.tiles.mapbox.com https://tile.openstreetmap.org https://*.tile.opentopomap.org data: blob:; style-src 'self' 'unsafe-inline' https://api.mapbox.com; script-src 'self' 'unsafe-inline' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon-256.png",
      "icons/icon-128.png",
      "icons/icon-32.png"
    ],
    "category": "Utility",
    "shortDescription": "Radar data research tool",
    "longDescription": "Open, process, visualise and export weather radar data (NEXRAD, ODIM, CfRadial and more).",
    "fileAssociations": [
      {
        "ext": [
          "nc",
          "ncf",
          "cdf"
        ],
        "name": "Radar volume (NetCDF / CfRadial)",
        "description": "NetCDF / CfRadial radar volume",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/x-netcdf"
      },
      {
        "ext": [
          "h5",
          "hdf5",
          "hdf"
        ],
        "name": "Radar volume (ODIM / HDF5)",
        "description": "ODIM / HDF5 radar volume",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/x-hdf5"
      },
      {
        "ext": [
          "gz"
        ],
        "name": "Radar volume (compressed NEXRAD Level II)",
        "description": "Compressed NEXRAD Level II volume",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/gzip"
      },
      {
        "ext": [
          "bz2"
        ],
        "name": "Radar volume (compressed)",
        "description": "Compressed radar volume",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/x-bzip2"
      },
      {
        "ext": [
          "raw",
          "RAW",
          "vol",
          "azi",
          "scn",
          "scnx",
          "uf"
        ],
        "name": "Radar volume",
        "description": "Radar volume (IRIS, Rainbow, Furuno, UF)",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/octet-stream"
      },
      {
        "ext": [
          "ar2v",
          "nexrad"
        ],
        "name": "Radar file (any format xradar reads)",
        "description": "Radar file",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "public.data"
        ]
      }
    ]
  }
}
