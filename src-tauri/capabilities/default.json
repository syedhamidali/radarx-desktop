{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Radarx Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
