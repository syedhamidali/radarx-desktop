# xradar web build (static site, e.g. Render / Netlify). Copy to .env.web (or set these as
# build-time environment variables on the host) and run `npm run build:web`.
# The desktop (Tauri) build ignores all of this.

# WebSocket address of the remote engine. Required for the web build: the page connects to it
# instead of a local sidecar. wss:// for https sites, ws:// only for local development.
# For development you can also open the page with ?engine=wss://host (overrides this value).
VITE_ENGINE_URL=wss://xradar-engine.onrender.com

# Notes
# - The engine must allow your site's origin (its own allowed-origins setting).
# - Free hosts sleep: the first connection can take 30-60 s; the UI says "Engine waking up".
# - `npm run build:web` also writes a Content-Security-Policy <meta> tag limiting connect-src to
#   this page and VITE_ENGINE_URL. Without VITE_ENGINE_URL no tag is written; add an equivalent
#   Content-Security-Policy header on the host instead.
# - Publish directory: dist-web

# Accounts (Supabase). Both values are PUBLIC identifiers (row-level security protects the data) and are
# already built in; set these only to point a build at a different project. NEVER put the database
# password or a service-role key here. See docs/ACCOUNTS.md.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_KEY=sb_publishable_...
